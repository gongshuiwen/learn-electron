# Copy to .env, replace the token, then start server and web in separate terminals.
# Generate a token: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_API_TOKEN=
APP_PORT=4318
APP_DATA_DIR=.data
APP_ENGINE=

# Pi selects a model with configured server-side credentials. Set both to pin one.
PI_PROVIDER=deepseek
PI_MODEL=
DEEPSEEK_API_KEY=

# Explicit offline demo: APP_ENGINE=mock (never used as an automatic fallback).
# APP_ALLOWED_ORIGINS=https://chat.example.com
