{
  "name": "learn-electron",
  "version": "1.0.0",
  "description": "An Electron desktop app with TypeScript, React and Tailwind CSS",
  "private": true,
  "license": "MIT",
  "author": "gongshuiwen",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run typecheck && electron-vite build",
    "test:smoke": "npm run build && install-electron && node --test tests/smoke.test.mjs",
    "test:example": "npm run build && install-electron && node --test tests/example.test.mjs",
    "prepreview": "install-electron",
    "preview": "electron-vite preview --skipBuild"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
