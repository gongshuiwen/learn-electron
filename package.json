{
  "name": "learn-electron",
  "version": "1.0.0",
  "description": "An Electron desktop app with TypeScript, React and Tailwind CSS",
  "private": true,
  "license": "MIT",
  "author": "gongshuiwen",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "dev:server": "tsx --watch apps/server/src/cli.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "start:server": "node out/server/index.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:server-modules && npm run format:check",
    "check:server-modules": "node scripts/check-server-modules.mjs",
    "typecheck": "npm run typecheck:desktop && npm run typecheck:server && npm run typecheck:web",
    "typecheck:desktop": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:server": "tsc --noEmit -p apps/server/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . --max-warnings 0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "npm run typecheck:desktop && npm run typecheck:web && npm run build:server && electron-vite build",
    "build:server": "npm run typecheck:server && node scripts/build-server.mjs",
    "build:web": "npm run typecheck:web && vite build --config vite.web.config.ts",
    "prepreview": "install-electron",
    "preview": "electron-vite preview --skipBuild",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "npm run test:boundaries && npm run test --workspaces --if-present",
    "test:boundaries": "node --test \"scripts/test/*.test.mjs\"",
    "test:desktop": "npm run test --workspace @learn-electron/desktop",
    "test:desktop:smoke": "npm run test:smoke --workspace @learn-electron/desktop",
    "test:desktop:packaged": "npm run test:packaged --workspace @learn-electron/desktop",
    "test:server": "npm run test --workspace @learn-electron/server",
    "test:web": "npm run test --workspace @learn-electron/web",
    "test:runtime": "npm run test --workspace @learn-electron/agent-runtime",
    "test:contracts": "npm run test --workspace @learn-electron/contracts",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "pack": "npm run build && npm run prepare:runtime && electron-builder --dir --publish never",
    "dist": "npm run build && npm run prepare:runtime && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.3.5"
  }
}
