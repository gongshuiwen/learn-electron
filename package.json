{
  "name": "learn-electron",
  "version": "1.0.0",
  "description": "An Electron desktop app with TypeScript, React and Tailwind CSS",
  "private": true,
  "license": "MIT",
  "author": "gongshuiwen",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint . --max-warnings 0",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never",
    "test:smoke": "npm run build && install-electron && node --test tests/smoke.test.mjs",
    "test:example": "npm run build && install-electron && node --test tests/example.test.mjs",
    "prepreview": "install-electron",
    "preview": "electron-vite preview --skipBuild"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5"
  }
}
